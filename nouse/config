exec --no-startup-id lxpolkit &
# Set the Mod key to the Super/Windows key
set $mod Mod4

# Making every opened app floating mode
# for_window [class=".*"] floating enable


# Font for window titles. (Requires a Nerd Font installed for best results)
font pango:monospace 10

# Use Mouse+$mod to drag floating windows to their desired position
floating_modifier $mod

# -- Auto run's --

# xprofile
# Cursor speed
# Logitech mouse
#exec_always --no-startup-id xinput set-prop 7 "libinput Accel Profile Enabled" 0 1 0
#exec_always --no-startup-id xinput set-prop 7  "libinput Accel Speed" -0.1

# Lenovo ideapad 1 15IGL7 Touchpad
# Cursor speed
exec_always --no-startup-id xinput set-prop 9 "libinput Accel Profile Enabled" 0 1 0
exec_always --no-startup-id xinput set-prop 9 "libinput Accel Speed" -0.5

exec_always --no-startup-id xinput set-prop 7 "libinput Accel Profile Enabled" 0 1 0
exec_always --no-startup-id xinput set-prop 7 "libinput Accel Speed" 0.5

# Enabling tap-to-click
exec_always --no-startup-id xinput set-prop 9 "libinput Tapping Enabled" 1

# Input delay (Use 200 20/25/30/35/40 for 60 hz screens) 
exec_always --no-startup-id xset r rate 200 20

# Global cursor theme and size
exec_always --no-startup-id export XCURSOR_THEME="Adwaita"
exec_always --no-startup-id export XCURSOR_SIZE="16"
exec_always --no-startup-id xsetroot -adwaita left_ptr

exec_always --no-startup-id ~/dotfiles/x11/auto-sensivity/set_xinput_sensivity.sh

# Auto lock when sleeping
exec --no-startup-id xfce4-screensaver &
# Autotiling
exec_always --no-startup-id sleep 2; /home/emre/.local/bin/autotiling

# Split in horizontal orientation
#bindsym $mod+h split h

# Split in vertical orientation
#bindsym $mod+Shift+v split v

# Picom
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf -b

# Set wallpaper (Ensure you have image and 'feh' installed)
exec_always --no-startup-id feh --bg-scale ~/dotfiles/wallpapers/5.jpg

# Always merge Xresources
#exec_always xrdb -merge ~/dotfiles/xresources/.Xresources

# Launch Polybar on startup
exec_always --no-startup-id pkill polybar; polybar mintbar &

